<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PantryPal.Controls.TabHeader">

    <VerticalStackLayout Spacing="6" Padding="0,12,0,8">
        
        <Border BackgroundColor="{StaticResource PantryField}" StrokeThickness="0"
                StrokeShape="RoundRectangle 16" Padding="8" HorizontalOptions="Center">
            <HorizontalStackLayout Spacing="8">

                <!-- CommandParameter holds the Route of the Tab in AppShell.xaml -->
                <Button x:Name="FavoritesButton" Text="Favorites" ImageSource="tab_favorites.png"
                        CommandParameter="favorites" Clicked="OnTabClicked" />
                <Button x:Name="RecipesButton" Text="Find Recipes" ImageSource="tab_recipes.png"
                        CommandParameter="recipes" Clicked="OnTabClicked" />
                <Button x:Name="PantryButton" Text="My Pantry" ImageSource="tab_pantry.png"
                        CommandParameter="pantry" Clicked="OnTabClicked" />
            </HorizontalStackLayout>
        </Border>

        <!-- the page name-->
        <Label x:Name="TitleLabel" TextColor="{StaticResource PantryOrange}"
               FontFamily="OpenSansSemibold" FontSize="18" HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentView>
