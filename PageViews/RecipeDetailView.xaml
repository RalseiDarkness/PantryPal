<?xml version="1.0" encoding="utf-8" ?>
<!-- one recipe, opened by tapping a card on the recipes page -->
<!-- x:DataType on the page means every {Binding} here reads from a RecipeSearchResult -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PantryPal.Models"
             x:Class="PantryPal.PageViews.RecipeDetailView"
             x:DataType="models:RecipeSearchResult"
             BackgroundColor="{StaticResource PantryBackground}">

    <!-- row 0 back button, row 1 the recipe, which scrolls -->
    <Grid RowDefinitions="Auto,*" RowSpacing="12" Padding="24,16,24,0" MaximumWidthRequest="680">

        <!-- the shell's own back arrow is hidden, so this page has its own -->
        <Button Text="Back to recipes" Clicked="OnBackClicked" HorizontalOptions="Start"
                BackgroundColor="{StaticResource PantryCard}" TextColor="{StaticResource PantryText}"
                FontFamily="OpenSansSemibold" CornerRadius="12" Padding="16,8" />

        <!-- ScrollView lets a long recipe scroll instead of getting cut off -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="8" Padding="0,0,0,24">

                <!-- the Border rounds the photo corners, hidden when there is no photo -->
                <Border IsVisible="{Binding HasImage}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 22" HeightRequest="260">
                    <Image Source="{Binding ImageURL}" Aspect="AspectFill" />
                </Border>

                <Label Text="{Binding Title}" Style="{StaticResource ItemTitle}"
                       FontSize="24" LineBreakMode="WordWrap" />
                <Label Text="{Binding Summary}" Style="{StaticResource ItemDetail}" />

                <Label Text="{Binding Overview}" Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasOverview}" />

                <Label Text="AI recommendation" Style="{StaticResource SectionTitle}"
                       IsVisible="{Binding HasWhyItMatches}" />
                <Label Text="{Binding WhyItMatches}" Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasWhyItMatches}" />

                <Label Text="Match assessment" Style="{StaticResource SectionTitle}"
                       IsVisible="{Binding HasMatchAssessment}" />
                <Label Text="{Binding MatchAssessment}" Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasMatchAssessment}" />

                <Label Text="{Binding Difficulty, StringFormat='Difficulty: {0}'}"
                       Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasDifficulty}" />

                <Label Text="Region of Origin" Style="{StaticResource SectionTitle}"
                       IsVisible="{Binding HasRegionOfOrigin}" />
                <Label Text="{Binding RegionOfOrigin}" Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasRegionOfOrigin}" />
                <Label Text="Origin Sources" Style="{StaticResource SectionTitle}"
                       IsVisible="{Binding HasOriginSources}" />
                <Label Text="{Binding OriginSourcesText}" Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasOriginSources}" />

                <Label Text="Light or Filling" Style="{StaticResource SectionTitle}"
                       IsVisible="{Binding HasMealHeaviness}" />
                <Label Text="{Binding MealHeavinessText}" Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasMealHeaviness}" />

                <Label Text="Potential Allergens" Style="{StaticResource SectionTitle}"
                       IsVisible="{Binding HasPotentialAllergens}" />
                <Label Text="{Binding PotentialAllergensText}" Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasPotentialAllergens}" />
                <Label Text="Allergen Evidence" Style="{StaticResource SectionTitle}"
                       IsVisible="{Binding HasAllergenExplanations}" />
                <Label Text="{Binding AllergenExplanationsText}" Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasAllergenExplanations}" />

                <Label Text="Other Considerations" Style="{StaticResource SectionTitle}"
                       IsVisible="{Binding HasOtherConsiderations}" />
                <Label Text="{Binding OtherConsiderations}" Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasOtherConsiderations}" />

                <!-- ingredients from the pantry and the ones still needed -->
                <Label Text="You have" Style="{StaticResource SectionTitle}"
                       IsVisible="{Binding HasMatchingIngredients}" />
                <Label Text="{Binding HaveText}" Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasMatchingIngredients}" />

                <Label Text="You still need" Style="{StaticResource SectionTitle}"
                       IsVisible="{Binding HasMissingIngredients}" />
                <Label Text="{Binding NeedText}" Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasMissingIngredients}" />

                <Label Text="Suggested substitutions" Style="{StaticResource SectionTitle}"
                       IsVisible="{Binding HasSubstitutions}" />
                <Label Text="{Binding SubstitutionsText}" Style="{StaticResource BodyText}"
                       IsVisible="{Binding HasSubstitutions}" />
                
                <!-- Opens recipe step carosuel-->
                <Button Text="Step-by-step guide" Style="{StaticResource WideButton}"
                        Clicked="OnCookAlongClicked" Margin="0,8,0,0" />

                <!-- opens the website the recipe came from -->
                <Button Text="Open original recipe" Style="{StaticResource WideButton}"
                        IsVisible="{Binding HasSource}" Clicked="OnOpenSourceClicked" Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
