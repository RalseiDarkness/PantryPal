<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PantryPal.Controls"
             x:Class="PantryPal.PageViews.HomeView"
             Title="Home"
             BackgroundColor="{StaticResource PantryBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- Tabs and page name -->
        <controls:TabHeader PageTitle="Welcome" />


        <VerticalStackLayout Grid.Row="1" Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">

            <Label FontSize="24"
            TextColor="{StaticResource PantryMutedText}"
            HorizontalTextAlignment="Center">

                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Welcome to " />
                        <Span Text="PantryPal" FontAttributes="Bold" />
                        <Span Text="!" />
                    </FormattedString>
                </Label.FormattedText>

            </Label>

            <Label Text="Use the tabs to explore recipes."
            TextColor="{StaticResource PantryMutedText}"
            HorizontalOptions="Center" VerticalOptions="Center" FontSize="12"/>


        </VerticalStackLayout>

    </Grid>

</ContentPage>