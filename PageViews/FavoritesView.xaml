<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PantryPal.Models"
             xmlns:controls="clr-namespace:PantryPal.Controls"
             x:Class="PantryPal.PageViews.FavoritesView"
             Title="Favorites"
             BackgroundColor="{StaticResource PantryBackground}">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Padding="24,0,24,20">

        <!-- Tabs and page name -->
        <controls:TabHeader PageTitle="Favorites" />

        <CollectionView Grid.Row="1" x:Name="FavoritesList"
                        SelectionMode="None" ItemSizingStrategy="MeasureAllItems">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center" Spacing="4">
                    <Label Text="No favorite recipes yet"
                           Style="{StaticResource ItemTitle}"
                           HorizontalOptions="Center" />
                    <Label Text="Tap a recipe's star to save it here."
                           Style="{StaticResource ItemDetail}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RecipeSearchResult">
                    <Grid Padding="0,0,0,12">
                        <Border BackgroundColor="{StaticResource PantryCard}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                Margin="5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRecipeTapped" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto">
                                <Image Grid.RowSpan="2" Source="{Binding ImageURL}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding HasImage}"
                                       HeightRequest="120" WidthRequest="100" />

                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto"
                                      Padding="14,12,10,4">
                                    <Label Text="{Binding Title}"
                                           Style="{StaticResource ItemTitle}"
                                           FontSize="18" />
                                    <ImageButton Grid.Column="1"
                                                 Source="red_cross.png"
                                                 WidthRequest="28" HeightRequest="28"
                                                 Clicked="OnRemoveFavoriteClicked"
                                                 SemanticProperties.Description="Remove from favorites" />
                                </Grid>

                                <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                                                     Padding="14,0,14,12" Spacing="3">
                                    <Label Text="{Binding ReadyInMinutes, StringFormat='Preparation: {0} minutes'}"
                                           Style="{StaticResource ItemDetail}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding ReadyInMinutes}"
                                                         Value="{x:Null}">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Servings, StringFormat='Servings: {0}'}"
                                           Style="{StaticResource ItemDetail}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Servings}"
                                                         Value="{x:Null}">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Difficulty, StringFormat='Difficulty: {0}'}"
                                           IsVisible="{Binding HasDifficulty}"
                                           Style="{StaticResource ItemDetail}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="2" x:Name="FavoritesStatusLabel"
               Style="{StaticResource ItemDetail}" IsVisible="False"
               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
    </Grid>

</ContentPage>
