<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PantryPal.Controls"
             xmlns:models ="clr-namespace:PantryPal.Models"
             x:Class="PantryPal.PageViews.RecipesView"
             Title="Find Recipes"
             BackgroundColor="{StaticResource PantryBackground}"
             x:DataType="models:FindRecipes">
    <ContentPage.BindingContext>
        <models:FindRecipes />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Tabs and page name -->
        <controls:TabHeader PageTitle="Find Recipes" />

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Recipes}"
                        Margin="30">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                    <Label Text="Recipes that match your pantry will show up here." Style="{StaticResource ItemTitle}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" 
                    Span="4"
                    HorizontalItemSpacing="15"
                    VerticalItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Recipe">

                    <Border
                        WidthRequest="270"
                        HeightRequest="200"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        StrokeThickness="0"
                        BackgroundColor="white"
                        StrokeShape="RoundRectangle 25"
                        Margin="5,5,10,5">

                        <Grid RowDefinitions="110, *, Auto">

                                <Image Grid.Row="0"
                                    Source="{Binding Image}"
                                    Aspect="AspectFill"/>

                                <Image Grid.Row="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Source="{Binding FavoriteStar}"
                                        WidthRequest="15"
                                        HeightRequest="15"
                                        Margin="10"/>

                                <Grid Grid.Row="1"
                                    ColumnDefinitions="*, Auto"
                                    Padding="10">
                                        <Label Margin="10"
                                        Text="{Binding Name}"
                                        FontSize="18"
                                        TextColor="black"
                                        FontAttributes="Bold"/>
                                        
                                        <HorizontalStackLayout Grid.Column="1"
                                                                Spacing="3">
                                            <Label Text="{Binding Rating}"
                                                    TextColor="Black"/>

                                            <Image Source="{Binding Mark}"
                                                    WidthRequest="15"
                                                    HeightRequest="15"/>

                                        </HorizontalStackLayout>
                                </Grid>
                                <Label Grid.Row="2"
                                        Margin="15,0,0,10"
                                        Text="{Binding Description}"
                                        FontSize="14"
                                        TextColor="black" />
                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
