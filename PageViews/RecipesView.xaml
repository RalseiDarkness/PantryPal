<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PantryPal.Controls"
             xmlns:models ="clr-namespace:PantryPal.Models"
             x:Class="PantryPal.PageViews.RecipesView"
             Title="Find Recipes"
             BackgroundColor="{StaticResource PantryBackground}"
             x:DataType="models:FindRecipes">
    <ContentPage.BindingContext>
        <models:FindRecipes />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Tabs and page name -->
        <controls:TabHeader PageTitle="Find Recipes" />

        <Label Grid.Row="1" Text="Recipes that match your pantry will show up here."
               TextColor="{StaticResource PantryMutedText}"
               HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>

</ContentPage>
