<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PantryPal.Controls"
             xmlns:models ="clr-namespace:PantryPal.Models"
             x:Class="PantryPal.PageViews.RecipesView"
             Title="Find Recipes"
             BackgroundColor="{StaticResource PantryBackground}"
             x:DataType="models:FindRecipes">
    <ContentPage.BindingContext>
        <models:FindRecipes />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Tabs and page name -->
        <controls:TabHeader PageTitle="Find Recipes" />

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Recipes}"
                        Margin="30">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                    <Label Text="Recipes that match your pantry will show up here." Style="{StaticResource ItemTitle}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" 
                    Span="4"
                    HorizontalItemSpacing="5"
                    VerticalItemSpacing="5" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Recipe">

                    <Border
                        WidthRequest="250"
                        HeightRequest="250"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        StrokeThickness="0"
                        BackgroundColor="white">

                        <VerticalStackLayout>
                            <Label
                                Margin="10"
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="black" />

                            <Label
                                Margin="10"
                                Text="{Binding Description}"
                                FontSize="14"
                                TextColor="black" />
                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
