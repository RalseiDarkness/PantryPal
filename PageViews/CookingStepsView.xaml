<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PantryPal.PageViews.CookingStepsView"
             BackgroundColor="{StaticResource PantryBackground}">

    <Grid Padding="24,20"
          RowDefinitions="Auto,*"
          RowSpacing="16"
          MaximumWidthRequest="680">

        <Button Grid.Row="0"
                Text="Back to recipe"
                Clicked="OnBackClicked"
                HorizontalOptions="Start"
                BackgroundColor="{StaticResource PantryCard}"
                TextColor="{StaticResource PantryText}"
                CornerRadius="12"
                Padding="16,8" />

        <!-- All instruction cards are created from the stored recipe steps, so the complete recipe can scroll as one page. -->
        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Always">

            <VerticalStackLayout Spacing="18">

                <Label x:Name="RecipeTitle"
                       FontSize="26"
                       FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource PantryText}" />

                <Label Text="Cooking instructions"
                       FontSize="21"
                       FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource PantryOrange}" />

                <Label x:Name="NoInstructionsLabel"
                       IsVisible="False"
                       Text="Sorry, no Instructions but visit the website to learn more"
                       FontSize="17"
                       TextColor="{StaticResource PantryText}" />

                <VerticalStackLayout x:Name="StepsLayout"
                                     Spacing="14" />

                <Button x:Name="SourceButton"
                        Text="Visit original recipe website"
                        Clicked="OnSourceClicked"
                        IsVisible="False"
                        Style="{StaticResource WideButton}" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
