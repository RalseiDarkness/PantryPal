<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PantryPal.PageViews.PantryView"
             Title="My Pantry"
             BackgroundColor="#FAEBDD"
             >


    <Grid RowDefinitions="*,Auto" Padding="20">

        <CollectionView Grid.Row="0" x:Name="PantryList">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border BackgroundColor="#FBC29B" Padding="15" Margin="0,0,0,10" Stroke="DarkOrange">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" /> 

                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" TextColor="Black" FontAttributes="Bold" />
                                <Label Text="{Binding Brand}" TextColor="Black" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="End" >
                                
                                <Label Text="{Binding DateAdded, StringFormat='{0:MM/dd}'}" TextColor="Black" FontSize="12" />
                                <Label Text="{Binding Price, StringFormat='${0:F2}'}" Padding="20,0" TextColor="Black" />
                                
                            </VerticalStackLayout>

                            <Button Grid.Column="2" Text="X" BackgroundColor="#E5566D" TextColor="White"
                            WidthRequest="40" HeightRequest="40" Padding="0"
                            Clicked="OnRemoveClicked" />

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
        ColumnSpacing="10" RowSpacing="8">

            <Entry x:Name="IngredientEntry" Placeholder="Ingredient name" TextColor="Black" />

            <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                
                <Entry x:Name="BrandEntry" Placeholder="Brand" TextColor="Black" />
                
                <Entry Grid.Column="1" x:Name="PriceEntry" Placeholder="Price"
                Keyboard="Numeric" TextColor="Black" />
                
                <DatePicker Grid.Column="2" x:Name="DateEntry" TextColor="Black" />
                
            </Grid>

            <Button Grid.Column="1" Grid.RowSpan="2" Text="+" BackgroundColor="#F26100"
            TextColor="White" Clicked="OnAddClicked" />
            
        </Grid>

    </Grid>

</ContentPage>