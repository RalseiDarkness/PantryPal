<?xml version="1.0" encoding="UTF-8" ?>
<!-- styles used by more than one page, App.xaml loads this file so every page can use them -->
<!-- styles only one page needs stay in that page's ContentPage.Resources -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- bold name on a card, like an ingredient or a recipe title -->
    <Style x:Key="ItemTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource PantryText}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- smaller grey text under a title -->
    <Style x:Key="ItemDetail" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource PantryMutedText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- heading for a section of a page, like Steps -->
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource PantryText}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- normal paragraph text that wraps onto more lines -->
    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource PantryText}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <!-- big orange button, like Find recipes -->
    <Style x:Key="WideButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PantryOrange}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

</ResourceDictionary>
