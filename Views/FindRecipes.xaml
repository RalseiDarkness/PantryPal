<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models ="clr-namespace:PantryPal.Models"
             x:Class="PantryPal.Views.FindRecipes"
             x:DataType="models:FindRecipes">
    <ContentPage.BindingContext>
        <models:FindRecipes />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="5" Margin="20">
            <Label
                Text="Results"
                FontSize="28"
                FontAttributes="Bold"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Recipes}" 
                        ItemsLayout="HorizontalList">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Recipe">

                    <Border
                        Padding="15"
                        Margin="15"
                        WidthRequest="250"
                        HeightRequest="250"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Stroke="LightGray"
                        StrokeThickness="1">

                        <VerticalStackLayout>
                            <Label
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Description}"
                                FontSize="14" />
                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>