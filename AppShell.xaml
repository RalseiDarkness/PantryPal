<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PantryPal.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PantryPal.Views"
    xmlns:pageviews="clr-namespace:PantryPal.PageViews"
    Title="PantryPal"
    >

    <TabBar>
        <Tab Title="Home">
            <ShellContent
                 ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>         
        <Tab Title="Favorites" Icon="bookmark.png">
            <ShellContent 
                ContentTemplate="{DataTemplate views:Favorites}" />
        </Tab>
        <Tab Title="Find Recipes" Icon="search.png">
            <ShellContent 
                ContentTemplate="{DataTemplate views:FindRecipes}" />
        </Tab>
        <Tab Title="Pantry Items" Icon="restaurant.png">
            <ShellContent 
                ContentTemplate="{DataTemplate pageviews:PantryView}" />
        </Tab>
    </TabBar>

</Shell>