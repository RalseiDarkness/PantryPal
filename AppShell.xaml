<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PantryPal.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PantryPal.Views"
    Title="PantryPal">

    <ShellContent
        Title="Ingredients"
        ContentTemplate="{DataTemplate views:AllNotesPage}"
        Route="AllNotesPage" />

    <ShellContent
        Title="Practice"
        ContentTemplate="{DataTemplate views:Practice}"
        Route="Practice" />

</Shell>
