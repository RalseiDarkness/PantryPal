<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PantryPal.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PantryPal.Views"
    Title="PantryPal">

    <TabBar>
        <Tab Title="Favorites">
            <ShellContent 
                ContentTemplate="{DataTemplate views:Favorites}" />
        </Tab>
        <Tab Title="FindRecipes">
            <ShellContent 
                ContentTemplate="{DataTemplate views:FindRecipes}" />
        </Tab>
    </TabBar>

</Shell>